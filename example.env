# ==========================================
# Superpages 系統環境變數範本 (example.env)
# ==========================================
# 請將此檔案複製一份並重新命名為 .env，然後填入你自己的環境變數數值。
# 注意：.env 檔案已經被加入 .gitignore，請勿將含有真實密碼的 .env 檔案上傳至版本控制系統。

# ------------------------------------------
# 1. 資料庫設定
# ------------------------------------------
# 系統主資料庫連線字串 (格式：postgresql://帳號:密碼@主機:通訊埠/資料庫名稱)
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb

# ------------------------------------------
# 2. 安全性與金鑰
# ------------------------------------------
# Flask Session 簽名與 JWT Token 加密所使用的密鑰 (請設定一個隨機的長字串，例如 32 個以上的英數字)
SECRET_KEY=replace_this_with_a_super_secret_random_string

# ------------------------------------------
# 3. 跨域請求白名單 (CORS)
# ------------------------------------------
# 允許哪些前端網域呼叫這個後端 API (若有多個請用逗號分隔)
# 注意：系統預設已允許所有 https://*.github.io 網域，若無其他需求可留空
CORS_ORIGINS=http://localhost:3000,http://localhost:9016

# ------------------------------------------
# 4. Syslog (NAS Log Center) �]�w
# ------------------------------------------
NAS_SYSLOG_HOST=
NAS_SYSLOG_PORT=6514
NAS_SYSLOG_APPNAME=superpages_docker
NAS_SYSLOG_TLS=true

